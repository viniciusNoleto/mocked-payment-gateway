APP_ENV=local
APP_PORT=3000

POSTGRES_DB=mocked_payment_gateway
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# Auto (nome do serviço no docker compose). Rodando fora do Docker, use localhost.
POSTGRES_HOST=mocked-payment-gateway-postgres

# Central aberta (painel e /api/central/*): clientes, chaves e todas as cobranças, sem login. Desligue fora de ambientes de teste.
NUXT_CENTRAL_ENABLED=true
# URL pública do gateway (vai na location do BR Code)
NUXT_PUBLIC_BASE_URL=http://localhost:3000
# Worker em processo (webhooks, expiração, auto-pagamento)
NUXT_WORKER_ENABLED=true
NUXT_WORKER_INTERVAL_MS=1000
NUXT_WEBHOOK_TIMEOUT_MS=5000
NUXT_WEBHOOK_RETRY_SCHEDULE=10,30,60,300,900,1800,3600,7200,14400,28800

# Seed — merchant padrão (npm run db:seed). Chaves vazias são geradas e exibidas no terminal.
SEED_MERCHANT_NAME="Loja Teste"
SEED_MERCHANT_API_KEY=
SEED_MERCHANT_WEBHOOK_URL=
SEED_MERCHANT_WEBHOOK_SECRET=
